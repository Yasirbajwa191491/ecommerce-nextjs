{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@ecommerce/shared": ["../../packages/shared/src/index.ts"],
      "@convex/*": ["../../convex/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../convex/_generated/**/*.ts"
  ]
}
