{
  "name": "ecommerce-nextjs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:backend",
    "dev:web": "npm run dev --workspace @ecommerce/web",
    "dev:frontend": "npm run dev --workspace @ecommerce/web",
    "dev:clean": "node scripts/clean-next-cache.mjs",
    "dev:fresh": "npm run dev:clean && npm run dev",
    "dev:backend": "convex dev",
    "dev:ai-worker": "npm run dev --prefix services/review-ai-worker",
    "ai-worker:install": "npm install --prefix services/review-ai-worker",
    "ai-worker:start": "npm run start --prefix services/review-ai-worker",
    "dev:sync-url": "node scripts/sync-convex-site-url.mjs",
    "build": "npm run build --workspace @ecommerce/web",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "npm run start --workspace @ecommerce/web",
    "lint": "npm run lint --workspace @ecommerce/web",
    "seed": "convex run seed:seedAll",
    "seed:admin": "convex run seed:seedAdminAndSettings",
    "vapi:setup": "node scripts/setup-vapi-assistant.mjs",
    "vapi:setup-review": "node scripts/setup-vapi-review-assistant.mjs",
    "vapi:setup:prod": "node scripts/setup-vapi-production.mjs",
    "ui:add": "npm run ui:add --workspace @ecommerce/web",
    "typecheck": "npm run typecheck --workspace @ecommerce/web",
    "dev:mobile": "node scripts/mobile-start.mjs",
    "mobile": "node scripts/mobile-start.mjs",
    "mobile:tunnel": "node scripts/mobile-start.mjs --tunnel",
    "mobile:env": "node scripts/sync-mobile-env.mjs",
    "typecheck:mobile": "npm run typecheck --workspace @ecommerce/mobile",
    "typecheck:all": "npm run typecheck && npm run typecheck:mobile",
    "lint:mobile": "npm run lint --workspace @ecommerce/mobile",
    "validate:mobile": "npm run validate --workspace @ecommerce/mobile"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "convex": "^1.40.0"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5"
  },
  "overrides": {
    "lan-network": "^0.1.6"
  }
}
