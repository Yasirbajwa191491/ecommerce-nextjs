# Python AI service — copy to .env for local development.
# Never commit .env. Never put these values in NEXT_PUBLIC_ or EXPO_PUBLIC_ variables.

APP_NAME=ecommerce-ai-service
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Server-to-server bearer token. Required when APP_ENV=production (minimum 32 characters).
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Optional during rotation: AI_SERVICE_API_KEY_PREVIOUS accepts the previous token until callers switch.
AI_SERVICE_API_KEY=
AI_SERVICE_API_KEY_PREVIOUS=

# Future Convex access. Leave blank until a least-privilege HTTP action exists.
# CONVEX_URL is the deployment URL (.convex.cloud). Do not send the service token there.
# CONVEX_INTERNAL_URL is the HTTP actions origin (.convex.site). Production values must be https://.
# CONVEX_SERVICE_TOKEN is not a Convex admin key and not a customer session.
CONVEX_URL=
CONVEX_INTERNAL_URL=
CONVEX_SERVICE_TOKEN=

# Reserved for local model files. The API does not load them on startup.
# ENABLE_MODEL_INFERENCE=false keeps /health/ready ready with model_inference disabled.
# true makes /health/ready load CONTENT_MODEL_DIR. A verified artifact returns 200
# with model_inference ready. A missing, corrupt, or incompatible artifact returns 503.
# The container probe stays on /health/live.
MODEL_ARTIFACTS_DIR=./artifacts
CONTENT_MODEL_DIR=
ENABLE_MODEL_INFERENCE=false

# Real catalog export. This is the Convex HTTP actions origin, not the .convex.cloud URL.
# CATALOG_EXPORT_TOKEN must match the Convex environment variable of the same name.
# Leave both blank until you intentionally export a catalog. Do not commit the token or the export.
CATALOG_EXPORT_URL=
CATALOG_EXPORT_TOKEN=

# Phase 3 behavioral artifacts. Leave blank until you train them.
# Inference stays off until ENABLE_MODEL_INFERENCE=true.
COLLABORATIVE_MODEL_DIR=
HYBRID_MODEL_DIR=

# Phase 4 neural artifact. Leave blank until you train neural-v1.
# Customer recommendations stay unchanged until the existing serve gate is on.
NEURAL_MODEL_DIR=

# Authorized behavioral export. Leave disabled. Convex must also set
# BEHAVIORAL_EXPORT_TOKEN and BEHAVIORAL_EXPORT_SALT or the route returns 503.
# Do not commit those values. Local training uses the synthetic generator instead.
BEHAVIORAL_EXPORT_ENABLED=false
BEHAVIORAL_EXPORT_URL=
BEHAVIORAL_EXPORT_TOKEN=
